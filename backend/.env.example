# Local demo uses SQLite and stores uploaded reports in backend/uploads/.
# For AI responses, set an OpenAI-compatible endpoint and API key:
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# The configured model must support image input for JPG/PNG report scanning.
LLM_MODEL=gpt-4o-mini

# For hosted PostgreSQL and private report storage, configure your Supabase project.
# The PostgreSQL connection URI can also be set as DATABASE_URL.
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional app configuration
CORS_ORIGINS=http://localhost:3000
DATA_DIR=./data
UPLOAD_DIR=./uploads
# PostgreSQL / Supabase schema is in supabase/schema.sql.
